# AI 예측 설정. 이 파일을 .env.local로 복사해서 채워요. 키가 하나도 없으면 규칙 기반 예측으로 동작해요.

# 무료로 쓰려면 Google AI Studio(https://aistudio.google.com/apikey)에서 Gemini 키를 받아 넣어요.
# 무료 등급은 보낸 내용이 구글 모델 개선에 쓰일 수 있어요.
GEMINI_API_KEY=
# 먼저 써 볼 Gemini 모델. 비워 두면 gemini-3.5-flash-lite부터 (붐비면 gemini-3.6-flash로 넘어가요)
GEMINI_MODEL=

# Claude를 쓰려면 (유료)
ANTHROPIC_API_KEY=

# 어떤 AI를 쓸지 직접 고르기: gemini | claude | rules. 비워 두면 키가 있는 쪽을 자동으로 골라요.
AI_PROVIDER=
